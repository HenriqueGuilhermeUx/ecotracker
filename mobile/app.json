{
  "expo": {
    "name": "EcoTracker",
    "slug": "ecotracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ecotracker",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#06100c",
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.alternativeventures.ecotracker",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "permissions": []
    },
    "ios": {
      "bundleIdentifier": "com.alternativeventures.ecotracker",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "company": "Alternative Ventures Ltda",
      "cnpj": "61.920.356/0001-38",
      "eas": {
        "projectId": "9746d183-5a05-435a-aeb6-b893002b7cb4"
      }
    }
  }
}
