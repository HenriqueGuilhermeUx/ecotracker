{
  "expo": {
    "name": "EcoTracker",
    "slug": "ecotracker",
    "version": "1.0.2",
    "orientation": "portrait",
    "scheme": "ecotracker",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#06100c",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.alternativeventures.ecotracker",
      "versionCode": 3,
      "edgeToEdgeEnabled": true,
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#06100c"
      }
    },
    "ios": {
      "bundleIdentifier": "com.alternativeventures.ecotracker",
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "company": "Alternative Ventures Ltda",
      "cnpj": "61.920.356/0001-38",
      "privacyUrl": "https://ecotracker10.netlify.app/privacy/",
      "termsUrl": "https://ecotracker10.netlify.app/terms/",
      "deletionUrl": "https://ecotracker10.netlify.app/delete-account/",
      "eas": {
        "projectId": "9746d183-5a05-435a-aeb6-b893002b7cb4"
      }
    }
  }
}
